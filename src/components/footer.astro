---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#151923] border-t border-gray-800/60 mt-auto">
    <div class="max-w-7xl mx-auto px-6 py-12 md:py-16">

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

        <div class="md:col-span-2 lg:col-span-1">
        <a href="/" class="text-2xl font-bold tracking-tight text-white inline-block mb-4 hover:opacity-80 transition-opacity">
        JLC<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">.dev</span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed max-w-xs">
        Building maintainable, scalable web applications and intuitive interfaces out of nothing.
        </p>
        </div>

        <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Explore</h3>
            <ul class="space-y-3 text-sm text-gray-400">
            <li><a href="#home" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">Home</a></li>
            <li><a href="#about" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">About Me</a></li>
            <li><a href="#projects" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">Projects</a></li>
            <li><a href="#skills" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">Skills</a></li>
            </ul>
        </div>

        <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Connect</h3>
            <ul class="space-y-3 text-sm text-gray-400">
            <li>
                <a href="https://github.com/JohnLloydCanoy" target="_blank" rel="noopener noreferrer" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">GitHub</a>
            </li>
            <li>
                <a href="https://www.linkedin.com/in/john-lloyd-canoy" target="_blank" rel="noopener noreferrer" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">LinkedIn</a>
            </li>
            <li>
                <a href="mailto:your.email@example.com" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">Email</a>
            </li>
            </ul>
        </div>

        <div>
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4">Resources</h3>
            <ul class="space-y-3 text-sm text-gray-400">
            <li><a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="hover:text-white hover:translate-x-1 inline-block transition-all duration-300">Resume</a></li>
            </ul>
        </div>

        </div>

        <div class="mt-16 pt-8 border-t border-gray-800/60 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-gray-500">
            &copy; {currentYear} John Lloyd Canoy. All rights reserved.
        </p>

        <p class="text-sm text-gray-500 flex items-center gap-1">
            Built with <span class="text-emerald-400">Astro</span> & <span class="text-blue-400">Tailwind</span>
        </p>
        </div>

    </div>
</footer>