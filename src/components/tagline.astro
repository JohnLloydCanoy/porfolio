---
import Button from "../components/buttons/a-button.astro";
---

<section class="py-12 px-4 max-w-4xl">
    <header class="space-y-4">
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-white">
        John Lloyd <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Canoy</span>
        </h1>

        <p class="text-xl md:text-2xl font-medium text-gray-300">
        Software Developer <span class="mx-2 text-gray-500">|</span> Open Source Enthusiast
        </p>

        <p class="text-lg md:text-xl text-gray-400 italic font-light tracking-wide uppercase">
        "Building something out of nothing"
        </p>
    </header>

    <div class="mt-8 flex flex-wrap gap-4">
        <Button variant="primary">View Resume</Button>
        <Button variant="outline">GitHub</Button>
        <Button variant="outline">LinkedIn</Button>
    </div>
</section>