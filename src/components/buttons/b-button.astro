---
// src/components/buttons/a-button.astro
interface Props {
    variant?: "primary" | "outline";
    href?: string;
    target?: string; // Add target prop
}

// Default to _self so internal links still work normally
const { variant = "primary", href = "#", target = "_self" } = Astro.props;

const baseStyles = "inline-flex items-center justify-center px-6 py-2.5 rounded-full font-medium transition-all duration-300 active:scale-95";

const variants = {
    primary: "bg-gradient-to-r from-blue-500 to-emerald-500 text-white shadow-lg hover:shadow-xl hover:opacity-90",
    outline: "border border-gray-600 text-gray-300 bg-transparent hover:text-white hover:border-gray-400 hover:bg-gray-800/50"
};

// Automatically apply security best practices for external tabs
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<a href={href} target={target} rel={rel} class={`${baseStyles} ${variants[variant]}`}>
    <slot />
</a>