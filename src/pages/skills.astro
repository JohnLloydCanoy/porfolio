---
const skillCategories = [
    {
        title: "Frontend Development",
        icon: "💻",
        skills: ["Astro", "Next.js", "Tailwind CSS", "HTML5", "CSS3"],
        theme: {
            cardHover: "hover:border-blue-500/50",
            iconBg: "bg-blue-500/10 border-blue-500/20",
            iconText: "text-blue-400",
            pillHover: "hover:border-blue-400"
        }
    },
    {
        title: "Backend & Systems",
        icon: "⚙️",
        skills: ["Python", "Django", "Java", "MySQL", "Supabase", "postgreSQL", "MongoDB", "Laravel"],
        theme: {
            cardHover: "hover:border-emerald-500/50",
            iconBg: "bg-emerald-500/10 border-emerald-500/20",
            iconText: "text-emerald-400",
            pillHover: "hover:border-emerald-400"
        }
    },
    {
        title: "Design & Tools",
        icon: "🎨",
        skills: ["Figma", "Photoshop", "Clip Studio Paint", "Git/GitHub", "UI/UX Principles"],
        theme: {
            cardHover: "hover:border-purple-500/50",
            iconBg: "bg-purple-500/10 border-purple-500/20",
            iconText: "text-purple-400",
            pillHover: "hover:border-purple-400"
        }
    }
];

const baseCardClasses = "bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 transition-all duration-300 hover:-translate-y-1";
const basePillClasses = "px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg transition-colors";
---

<section id="skills" class="py-20 md:py-32 relative">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-12 md:mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
                Core <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Skills</span>
            </h2>
            <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
            <p class="mt-6 text-gray-400 max-w-2xl text-lg leading-relaxed">
                A breakdown of the technologies, languages, and tools I use to build robust software solutions and craft engaging user experiences.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            {skillCategories.map((category) => (
                <div class={`${baseCardClasses} ${category.theme.cardHover}`}>
                    
                    <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-6 border ${category.theme.iconBg}`}>
                        <span class={`text-2xl ${category.theme.iconText}`}>{category.icon}</span>
                    </div>
                    
                    <h3 class="text-xl font-bold text-white mb-6">{category.title}</h3>
                    
                    <div class="flex flex-wrap gap-2.5">
                        {category.skills.map((skill) => (
                            <span class={`${basePillClasses} ${category.theme.pillHover}`}>
                                {skill}
                            </span>
                        ))}
                    </div>

                </div>
            ))}

        </div>
    </div>
</section>