---

<section id="skills" class="py-20 md:py-32 relative">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
            Core <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Skills</span>
        </h2>
        <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
        <p class="mt-6 text-gray-400 max-w-2xl text-lg leading-relaxed">
            A breakdown of the technologies, languages, and tools I use to build robust software solutions and craft engaging user experiences.
        </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <div class="bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 hover:border-blue-500/50 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mb-6 border border-blue-500/20">
            <span class="text-blue-400 text-2xl">💻</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-6">Frontend Development</h3>
            
            <div class="flex flex-wrap gap-2.5">
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-blue-400 transition-colors">Astro</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-blue-400 transition-colors">Next.js</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-blue-400 transition-colors">Tailwind CSS</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-blue-400 transition-colors">HTML5</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-blue-400 transition-colors">CSS3</span>
            </div>
        </div>

        <div class="bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 hover:border-emerald-500/50 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 bg-emerald-500/10 rounded-xl flex items-center justify-center mb-6 border border-emerald-500/20">
            <span class="text-emerald-400 text-2xl">⚙️</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-6">Backend & Systems</h3>
            
            <div class="flex flex-wrap gap-2.5">
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-emerald-400 transition-colors">Python</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-emerald-400 transition-colors">Django</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-emerald-400 transition-colors">Java</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-emerald-400 transition-colors">MySQL</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-emerald-400 transition-colors">Supabase</span>
            </div>
        </div>

        <div class="bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 hover:border-purple-500/50 hover:-translate-y-1 transition-all duration-300">
            <div class="w-12 h-12 bg-purple-500/10 rounded-xl flex items-center justify-center mb-6 border border-purple-500/20">
            <span class="text-purple-400 text-2xl">🎨</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-6">Design & Tools</h3>
            
            <div class="flex flex-wrap gap-2.5">
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-purple-400 transition-colors">Figma</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-purple-400 transition-colors">Photoshop</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-purple-400 transition-colors">Clip Studio Paint</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-purple-400 transition-colors">Git/GitHub</span>
            <span class="px-4 py-1.5 text-sm font-medium text-gray-300 bg-[#151923] border border-gray-700 rounded-lg hover:border-purple-400 transition-colors">UI/UX Principles</span>
            </div>
        </div>

        </div>
    </div>
</section>