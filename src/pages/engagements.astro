---
// 1. Data Array: All timeline items and their specific color themes live here
const engagements = [
    {
        title: "Startup Pitch & Development",
        date: "2025 - Present",
        organization: "Project A.N.I. & StayNet",
        description: "Actively developing and conceptualizing AI-driven agricultural platforms and local housing solutions. Engaging in the startup ecosystem to turn innovative ideas into viable software products.",
        theme: {
            dot: "border-emerald-500 group-hover:bg-emerald-500 group-hover:shadow-[0_0_15px_rgba(16,185,129,0.5)]",
            title: "group-hover:text-emerald-400",
            badge: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20"
        }
    },
    {
        title: "Founder & President",
        date: "2024",
        organization: "4-H Club, USTP-CDO",
        description: "Founded and led the 4-H Club chapter at the University of Science and Technology of Southern Philippines. Organized initiatives, managed team dynamics, and spearheaded community-focused agricultural and youth engagements.",
        theme: {
            dot: "border-blue-500 group-hover:bg-blue-500 group-hover:shadow-[0_0_15px_rgba(59,130,246,0.5)]",
            title: "group-hover:text-blue-400",
            badge: "text-blue-400 bg-blue-500/10 border-blue-500/20"
        }
    },
    {
        title: "Graphic Designer & Social Media Manager",
        date: "2023 - 2025",
        organization: "University Student Government",
        description: "Served as the creative lead for the USG, designing visual assets, managing digital presence, and effectively communicating student events and government initiatives to the broader university population.",
        theme: {
            dot: "border-purple-500 group-hover:bg-purple-500 group-hover:shadow-[0_0_15px_rgba(168,85,247,0.5)]",
            title: "group-hover:text-purple-400",
            badge: "text-purple-400 bg-purple-500/10 border-purple-500/20"
        }
    }
];
---

<section id="engagements" class="py-20 md:py-32 bg-[#151923]/50">
    <div class="max-w-4xl mx-auto px-6">
        
        <div class="mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
                Community & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Engagements</span>
            </h2>
            <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
            <p class="mt-6 text-gray-400 text-lg leading-relaxed">
                A timeline of my involvement in hackathons, student organizations, and tech communities.
            </p>
        </div>

        <div class="relative border-l border-gray-700/50 ml-3 md:ml-6 space-y-12">

            {engagements.map((item) => (
                <div class="relative pl-8 md:pl-12 group">
                    {/* Timeline Dot */}
                    <div class={`absolute w-4 h-4 bg-[#1e2330] border-2 rounded-full -left-[9px] top-1.5 transition-all duration-300 ${item.theme.dot}`}></div>
                    
                    {/* Header & Date Badge */}
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-2 gap-2">
                        <h3 class={`text-xl font-bold text-white transition-colors ${item.theme.title}`}>
                            {item.title}
                        </h3>
                        <span class={`text-sm font-medium px-3 py-1 rounded-full border w-max ${item.theme.badge}`}>
                            {item.date}
                        </span>
                    </div>

                    {/* Organization & Description */}
                    <h4 class="text-md font-medium text-gray-300 mb-3">{item.organization}</h4>
                    <p class="text-gray-400 leading-relaxed">
                        {item.description}
                    </p>
                </div>
            ))}

        </div>
    </div>
</section>