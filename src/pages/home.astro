---
import Tagline from "../components/tagline.astro";
import homeAsset from "../assets/Home-asset.png";
---

<section id = "home" class="min-h-[80vh] flex items-center justify-center py-12 md:py-20">
    <div class="container mx-auto max-w-7xl px-6 flex flex-col md:flex-row items-center justify-between gap-12 lg:gap-20 mt-15">
        
        <div class="flex-1 order-2 md:order-1 text-center md:text-left">
        <Tagline />
        </div>

        <div class="flex-1 order-1 md:order-2 flex justify-center">
        <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000"></div>
            
            <img
            src={homeAsset.src}
            alt="John Lloyd Canoy Portfolio Visual"
            class="relative w-full max-w-[450px] lg:max-w-[550px] h-auto rounded-2xl shadow-2xl transform transition-transform duration-500 hover:scale-[1.02]"
            loading="eager"
            />
        </div>
        </div>

    </div>
</section>