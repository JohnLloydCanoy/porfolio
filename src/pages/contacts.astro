const baseCardClasses = "flex items-center p-4 bg-[#151923] border border-gray-700 rounded-xl hover:bg-[#1a1f2e] transition-all duration-300 group hover:-translate-y-1";
---

<section id="contact" class="py-20 md:py-32 relative">
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        
        <div class="mb-12 md:mb-16 text-center md:text-left">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
                Get In <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Touch</span>
            </h2>
            <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full mx-auto md:mx-0"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        
            <div class="flex flex-col justify-center">
                <h3 class="text-2xl font-bold text-white mb-6">Let's build something together.</h3>
                <p class="text-gray-400 text-lg leading-relaxed mb-8">
                    Whether you have a question, an open-source project, or a potential startup idea, my inbox is always open. I'll try my best to get back to you!
                </p>

                <div class="space-y-6 mb-8">
                    <div class="flex items-center gap-4 group">
                        <div class="w-12 h-12 bg-[#1e2330] border border-gray-700/50 rounded-xl flex items-center justify-center group-hover:border-blue-500/50 transition-colors">
                            <span class="text-blue-400 text-xl">✉️</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Email Me</p>
                            <a href="mailto:canoy.john812@gmail.com" class="text-white font-medium hover:text-blue-400 transition-colors">canoy.john812@gmail.com</a>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 group">
                        <div class="w-12 h-12 bg-[#1e2330] border border-gray-700/50 rounded-xl flex items-center justify-center group-hover:border-emerald-500/50 transition-colors">
                            <span class="text-emerald-400 text-xl">📍</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-medium">Location</p>
                            <p class="text-white font-medium">Philippines</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 md:p-10 shadow-2xl flex flex-col justify-center">
                <h4 class="text-xl font-bold text-white mb-6">Connect With Me</h4>
                
                <div class="space-y-4">
                    
                    {socialLinks.map((link) => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class={`${baseCardClasses} ${link.hoverBorder}`}>
                            <div class={`text-gray-400 transition-colors ${link.hoverText}`}>
                                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill-rule="evenodd" d={link.iconPath} clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="ml-4 flex-grow">
                                <p class="text-white font-medium">{link.name}</p>
                                <p class="text-sm text-gray-400">{link.description}</p>
                            </div>
                            <div class={`text-gray-500 group-hover:translate-x-1 transition-all ${link.hoverText}`}>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>
                    ))}

                </div>
            </div>

        </div>
    </div>
</section>