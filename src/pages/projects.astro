---
import Button from '../components/buttons/a-button.astro';
---

<section id="projects" class="py-20 md:py-32 bg-[#151923]/50">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-12 md:mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
            Featured <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Projects</span>
        </h2>
        <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
        <p class="mt-6 text-gray-400 max-w-2xl text-lg">
            A selection of my recent work, ranging from AI-driven startups and automated analytics to desktop utilities.
        </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10">

        <div class="group bg-[#1e2330] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)] transition-all duration-300 flex flex-col">
            <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">ASAP</h3>
            <p class="text-gray-400 leading-relaxed mb-6 flex-1">
                An Automated Social Analytics Platform designed to streamline data gathering and insights. Built to handle complex data workflows efficiently.
            </p>
            <div class="flex flex-wrap gap-2 mb-8">
                <span class="px-3 py-1 text-xs font-medium text-blue-300 bg-blue-500/10 rounded-full border border-blue-500/20">Next.js</span>
                <span class="px-3 py-1 text-xs font-medium text-yellow-300 bg-yellow-500/10 rounded-full border border-yellow-500/20">Python</span>
                <span class="px-3 py-1 text-xs font-medium text-emerald-300 bg-emerald-500/10 rounded-full border border-emerald-500/20">Supabase</span>
            </div>
            <div class="flex gap-4 mt-auto">
                <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white hover:text-blue-400 transition-colors flex items-center gap-2">
                GitHub ↗
                </a>
            </div>
            </div>
        </div>

        <div class="group bg-[#1e2330] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition-all duration-300 flex flex-col">
            <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-emerald-400 transition-colors">Project A.N.I.</h3>
            <p class="text-gray-400 leading-relaxed mb-6 flex-1">
                An AI-driven agricultural platform concept aimed at modernizing farming practices and providing actionable, data-backed insights to users in the agricultural sector.
            </p>
            <div class="flex flex-wrap gap-2 mb-8">
                <span class="px-3 py-1 text-xs font-medium text-purple-300 bg-purple-500/10 rounded-full border border-purple-500/20">AI Integration</span>
                <span class="px-3 py-1 text-xs font-medium text-blue-300 bg-blue-500/10 rounded-full border border-blue-500/20">Full-Stack</span>
                <span class="px-3 py-1 text-xs font-medium text-green-300 bg-green-500/10 rounded-full border border-green-500/20">Startup Concept</span>
            </div>
            <div class="flex gap-4 mt-auto">
                <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white hover:text-emerald-400 transition-colors flex items-center gap-2">
                View Details ↗
                </a>
            </div>
            </div>
        </div>

        <div class="group bg-[#1e2330] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)] transition-all duration-300 flex flex-col">
            <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-blue-400 transition-colors">STAYNET</h3>
            <p class="text-gray-400 leading-relaxed mb-6 flex-1">
                A dedicated boarding house finder application developed to solve local housing search challenges, connecting students and renters with available accommodations.
            </p>
            <div class="flex flex-wrap gap-2 mb-8">
                <span class="px-3 py-1 text-xs font-medium text-indigo-300 bg-indigo-500/10 rounded-full border border-indigo-500/20">Web App</span>
                <span class="px-3 py-1 text-xs font-medium text-rose-300 bg-rose-500/10 rounded-full border border-rose-500/20">UI/UX Design</span>
            </div>
            <div class="flex gap-4 mt-auto">
                <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white hover:text-blue-400 transition-colors flex items-center gap-2">
                GitHub ↗
                </a>
            </div>
            </div>
        </div>

        <div class="group bg-[#1e2330] border border-gray-700/50 rounded-2xl overflow-hidden hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)] transition-all duration-300 flex flex-col">
            <div class="p-8 flex-1 flex flex-col">
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-emerald-400 transition-colors">DocuLens</h3>
            <p class="text-gray-400 leading-relaxed mb-6 flex-1">
                A Java-based desktop application engineered to parse, extract, and visualize complex data directly from PDF documents.
            </p>
            <div class="flex flex-wrap gap-2 mb-8">
                <span class="px-3 py-1 text-xs font-medium text-orange-300 bg-orange-500/10 rounded-full border border-orange-500/20">Java</span>
                <span class="px-3 py-1 text-xs font-medium text-cyan-300 bg-cyan-500/10 rounded-full border border-cyan-500/20">Desktop App</span>
                <span class="px-3 py-1 text-xs font-medium text-teal-300 bg-teal-500/10 rounded-full border border-teal-500/20">Data Parsing</span>
            </div>
            <div class="flex gap-4 mt-auto">
                <a href="#" target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-white hover:text-emerald-400 transition-colors flex items-center gap-2">
                GitHub ↗
                </a>
            </div>
            </div>
        </div>

        </div>
    </div>
</section>