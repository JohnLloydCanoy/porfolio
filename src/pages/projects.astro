---
import Button from '../components/buttons/b-button.astro';

// 1. Data Array: All your projects, their specific themes, and uniquely colored tags
const projects = [
    {
        title: "ASAP",
        description: "An Automated Social Analytics Platform designed to streamline data gathering and insights. Built to handle complex data workflows efficiently.",
        linkText: "GitHub ↗",
        linkUrl: "#",
        theme: {
            cardHover: "hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)]",
            textHover: "group-hover:text-blue-400",
            linkHover: "hover:text-blue-400"
        },
        tags: [
            { name: "Next.js", classes: "text-blue-300 bg-blue-500/10 border-blue-500/20" },
            { name: "Python", classes: "text-yellow-300 bg-yellow-500/10 border-yellow-500/20" },
            { name: "Supabase", classes: "text-emerald-300 bg-emerald-500/10 border-emerald-500/20" }
        ]
    },
    {
        title: "Project A.N.I.",
        description: "An AI-driven agricultural platform concept aimed at modernizing farming practices and providing actionable, data-backed insights to users in the agricultural sector.",
        linkText: "View Details ↗",
        linkUrl: "#",
        theme: {
            cardHover: "hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)]",
            textHover: "group-hover:text-emerald-400",
            linkHover: "hover:text-emerald-400"
        },
        tags: [
            { name: "AI Integration", classes: "text-purple-300 bg-purple-500/10 border-purple-500/20" },
            { name: "Full-Stack", classes: "text-blue-300 bg-blue-500/10 border-blue-500/20" },
            { name: "Startup Concept", classes: "text-green-300 bg-green-500/10 border-green-500/20" }
        ]
    },
    {
        title: "STAYNET",
        description: "A dedicated boarding house finder application developed to solve local housing search challenges, connecting students and renters with available accommodations.",
        linkText: "GitHub ↗",
        linkUrl: "#",
        theme: {
            cardHover: "hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)]",
            textHover: "group-hover:text-blue-400",
            linkHover: "hover:text-blue-400"
        },
        tags: [
            { name: "Web App", classes: "text-indigo-300 bg-indigo-500/10 border-indigo-500/20" },
            { name: "UI/UX Design", classes: "text-rose-300 bg-rose-500/10 border-rose-500/20" }
        ]
    },
    {
        title: "DocuLens",
        description: "A Java-based desktop application engineered to parse, extract, and visualize complex data directly from PDF documents.",
        linkText: "GitHub ↗",
        linkUrl: "#",
        theme: {
            cardHover: "hover:border-emerald-500/50 hover:shadow-[0_0_30px_rgba(16,185,129,0.15)]",
            textHover: "group-hover:text-emerald-400",
            linkHover: "hover:text-emerald-400"
        },
        tags: [
            { name: "Java", classes: "text-orange-300 bg-orange-500/10 border-orange-500/20" },
            { name: "Desktop App", classes: "text-cyan-300 bg-cyan-500/10 border-cyan-500/20" },
            { name: "Data Parsing", classes: "text-teal-300 bg-teal-500/10 border-teal-500/20" }
        ]
    }
];

// 2. Base styles for the project cards
const baseCardClasses = "group bg-[#1e2330] border border-gray-700/50 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col";
---

<section id="projects" class="py-20 md:py-32 bg-[#151923]/50">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-12 md:mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
                Featured <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Projects</span>
            </h2>
            <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
            <p class="mt-6 text-gray-400 max-w-2xl text-lg">
                A selection of my recent work, ranging from AI-driven startups and automated analytics to desktop utilities.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10">

            {projects.map((project) => (
                <div class={`${baseCardClasses} ${project.theme.cardHover}`}>
                    <div class="p-8 flex-1 flex flex-col">
                        
                        <h3 class={`text-2xl font-bold text-white mb-3 transition-colors ${project.theme.textHover}`}>
                            {project.title}
                        </h3>
                        
                        <p class="text-gray-400 leading-relaxed mb-6 flex-1">
                            {project.description}
                        </p>
                        
                        <div class="flex flex-wrap gap-2 mb-8">
                            {project.tags.map((tag) => (
                                <span class={`px-3 py-1 text-xs font-medium rounded-full border ${tag.classes}`}>
                                    {tag.name}
                                </span>
                            ))}
                        </div>
                        
                        <div class="flex gap-4 mt-auto">
                            <a href={project.linkUrl} target="_blank" rel="noopener noreferrer" class={`text-sm font-medium text-white transition-colors flex items-center gap-2 ${project.theme.linkHover}`}>
                                {project.linkText}
                            </a>
                        </div>

                    </div>
                </div>
            ))}

        </div>
    </div>
</section>