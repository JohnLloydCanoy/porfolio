---
const leadershipRoles = [
    {
        icon: "🤝",
        title: "Founder & President",
        organization: "4-H Club, USTP-CDO",
        date: "2024",
        description: "Identified a gap in campus organizations and took the initiative to found the university's 4-H Club chapter. Led executive meetings, delegated tasks to committee members, and spearheaded community-focused youth and agricultural initiatives from the ground up.",
        competencies: ["Team Management", "Project Scoping", "Public Speaking"],
        theme: {
            cardHover: "hover:border-blue-500/50 hover:shadow-[0_10px_30px_rgba(59,130,246,0.1)]",
            iconBg: "bg-blue-500/10 border-blue-500/20",
            iconText: "text-blue-400",
            titleHover: "group-hover:text-blue-400",
            badgeBg: "bg-blue-500/10 border-blue-500/20",
            badgeText: "text-blue-300"
        }
    },
    {
        icon: "🎨",
        title: "Creative Lead & SMM",
        organization: "University Student Government",
        date: "2023 — 2025",
        description: "Managed the digital presence and visual branding for the student government. Translated complex government initiatives and event details into clear, accessible, and highly engaging digital assets for the entire student body.",
        competencies: ["Visual Communication", "Brand Consistency", "Digital Strategy"],
        theme: {
            cardHover: "hover:border-emerald-500/50 hover:shadow-[0_10px_30px_rgba(16,185,129,0.1)]",
            iconBg: "bg-emerald-500/10 border-emerald-500/20",
            iconText: "text-emerald-400",
            titleHover: "group-hover:text-emerald-400",
            badgeBg: "bg-emerald-500/10 border-emerald-500/20",
            badgeText: "text-emerald-300"
        }
    }
];

const baseCardClasses = "group bg-[#1e2330]/80 backdrop-blur-sm border border-gray-700/50 rounded-2xl p-8 transition-all duration-300 flex flex-col hover:-translate-y-1";
---

<section id="leadership" class="py-20 md:py-32 relative">
    <div class="max-w-7xl mx-auto px-6">
        
        <div class="mb-12 md:mb-16">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4 uppercase">
                Leadership & <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Impact</span>
            </h2>
            <div class="w-20 h-1.5 bg-gradient-to-r from-blue-500 to-emerald-500 rounded-full"></div>
            <p class="mt-6 text-gray-400 max-w-2xl text-lg leading-relaxed">
                Writing code is only half the equation. I pride myself on my ability to communicate effectively, build communities, and take initiative outside of the IDE.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10">

            {leadershipRoles.map((role) => (
                <div class={`${baseCardClasses} ${role.theme.cardHover}`}>
                    
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between mb-6 gap-4">
                        <div>
                            <div class={`w-12 h-12 rounded-xl flex items-center justify-center mb-4 border group-hover:scale-110 transition-transform duration-300 ${role.theme.iconBg}`}>
                                <span class={`text-2xl ${role.theme.iconText}`}>{role.icon}</span>
                            </div>
                            <h3 class={`text-2xl font-bold text-white transition-colors ${role.theme.titleHover}`}>
                                {role.title}
                            </h3>
                            <h4 class="text-lg font-medium text-gray-400 mt-1">{role.organization}</h4>
                        </div>
                        <span class={`text-sm font-medium px-4 py-1.5 rounded-full border whitespace-nowrap ${role.theme.badgeBg} ${role.theme.badgeText}`}>
                            {role.date}
                        </span>
                    </div>

                    <p class="text-gray-300 leading-relaxed mb-6 flex-1">
                        {role.description}
                    </p>

                    <div class="pt-6 border-t border-gray-700/50">
                        <p class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-3">Key Competencies</p>
                        <div class="flex flex-wrap gap-2">
                            {/* Inner loop for competencies tags */}
                            {role.competencies.map((skill) => (
                                <span class="text-xs font-medium text-gray-400 bg-[#151923] px-3 py-1 rounded-md">
                                    {skill}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}

        </div>
    </div>
</section>